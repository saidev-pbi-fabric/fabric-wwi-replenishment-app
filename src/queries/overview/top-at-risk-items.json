{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top 10 stock items ranked by Suggested Reorder Qty (a sales-velocity-vs-lead-time proxy, not a real inventory level — see docs/wwi-schema-reference.md). Colored by Lead Time Priority Tier.",
  "mark": "bar",
  "height": { "step": 32 },
  "encoding": {
    "y": {
      "field": "StockItem",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 280,
        "labelExpr": "length(datum.value) > 38 ? slice(datum.value, 0, 22) + '…' + slice(datum.value, length(datum.value) - 13, length(datum.value)) : datum.value"
      }
    },
    "x": {
      "field": "SuggestedReorderQty",
      "type": "quantitative",
      "title": "Suggested Reorder Qty",
      "scale": { "zero": true }
    },
    "color": {
      "field": "LeadTimePriorityTier",
      "type": "nominal",
      "title": "Lead Time",
      "scale": { "domain": ["Short Lead Time", "Medium Lead Time", "Long Lead Time"] },
      "legend": null
    },
    "tooltip": [
      { "field": "StockItem", "type": "nominal", "title": "Item" },
      { "field": "LeadTimePriorityTier", "type": "nominal", "title": "Lead Time" },
      { "field": "SuggestedReorderQty", "type": "quantitative", "title": "Suggested Reorder Qty", "format": "," },
      { "field": "DemandTrend", "type": "quantitative", "title": "Demand Trend", "format": "+.0%" },
      { "field": "AtRiskRank", "type": "ordinal", "title": "Rank" }
    ]
  }
}
