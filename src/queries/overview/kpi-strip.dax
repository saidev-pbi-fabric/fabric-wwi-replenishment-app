EVALUATE
VAR TrackedItems = FILTER(ALL('Stock Item'), [Reorder Value Total] > 0)
RETURN
ROW(
    "Items Tracked", COUNTROWS(TrackedItems),
    "Avg Lead Time Days", ROUND(AVERAGEX(TrackedItems, 'Stock Item'[Lead Time Days]), 1),
    "Accelerating Demand Items", COUNTROWS(FILTER(TrackedItems, [Demand Trend %] > 0))
)
